{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exo-robotics.example/schemas/source-manifest.schema.json",
  "title": "Equipment Atlas source manifest",
  "type": "object",
  "required": ["schema_version", "machine_id", "configuration_id", "freeze_date", "repository_policy", "sources"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "machine_id": {"type": "string"},
    "configuration_id": {"type": "string"},
    "freeze_date": {"type": "string", "format": "date"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "publisher", "kind", "title", "official_url", "admission"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "publisher": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "official_url": { "type": "string", "pattern": "^https://" },
          "admission": { "enum": ["primary", "reference_only", "visual_only", "quarantined"] },
          "local_path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 1 },
          "pages": { "type": "integer", "minimum": 1 }
        },
        "allOf": [{
          "if": { "required": ["local_path"] },
          "then": { "required": ["sha256", "bytes"] }
        }]
      }
    }
  },
  "additionalProperties": true
}
