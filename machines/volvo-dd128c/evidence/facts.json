  "issues": [
    {"id": "weight-scope-conflict", "status": "documented", "detail": "The Canadian product page states 27,700 lb with ROPS fully ballasted, while the North American brochure states 28,430 lb under its own 50% fuel, 50% water, full hydraulics, 75 kg operator condition. The brochure value governs this candidate and the page value remains reference-only."},
    {"id": "width-label-conflict", "status": "documented", "detail": "The Canadian page labels overall width as 6 ft 7 in, while the brochure diagram distinguishes 2,218 mm dimension E from the 2,000 mm drum/rolling width F. This candidate preserves the brochure distinction."},
